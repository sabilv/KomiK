    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  }
}
