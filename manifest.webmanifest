{
  "id": "./",
  "name": "KomiK",
  "short_name": "KomiK",
  "description": "A private CBZ and CBR comic reader that runs in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0E0D0B",
  "theme_color": "#0E0D0B",
  "categories": ["books", "entertainment"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "name": "Comic archive", "accept": { "application/vnd.comicbook+zip": [".cbz"], "application/vnd.comicbook-rar": [".cbr"], "application/zip": [".zip"] } }
  ]
}
